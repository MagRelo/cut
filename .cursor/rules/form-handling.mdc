# Form Handling

Forms keep their draft in local state. The server validates the request. The client checks before submit and shows the failure with `ErrorMessage`.

- Field checks render under that field.
- Submit, wallet, and chain failures render under the submit button.
- Use `ErrorMessage` from `client/src/components/common/ErrorMessage.tsx`. Do not add a tinted error panel, a toast, or a one-off red paragraph.
- Pass `className` only for placement (`mt-1`, `text-center`) or a tighter size (`text-xs`).

## Example

```tsx
import { useState } from "react";
import { Button } from "../common/Button";
import { ErrorMessage } from "../common/ErrorMessage";

export const ExampleForm = () => {
  const [name, setName] = useState("");
  const [fieldError, setFieldError] = useState<string | null>(null);
  const [submitError, setSubmitError] = useState<string | null>(null);

  const handleSubmit = (event: React.FormEvent) => {
    event.preventDefault();
    setFieldError(null);
    setSubmitError(null);

    if (!name.trim()) {
      setFieldError("Name is required");
      return;
    }

    // submit, then setSubmitError(message) when the request fails
  };

  return (
    <form onSubmit={handleSubmit} className="space-y-4">
      <div>
        <label htmlFor="name">Name</label>
        <input id="name" value={name} onChange={(event) => setName(event.target.value)} />
        {fieldError ? <ErrorMessage message={fieldError} className="mt-1" /> : null}
      </div>
      <div className="flex flex-col items-center gap-2">
        <Button type="submit">Save</Button>
        {submitError ? <ErrorMessage message={submitError} /> : null}
      </div>
    </form>
  );
};
```
