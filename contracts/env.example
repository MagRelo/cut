# =============================================================================
# CONTRACTS / SCRIPTS ENVIRONMENT
# =============================================================================
# Copy to contracts/.env and fill in values.
#
# Consumers:
#   - foundry.toml ([rpc_endpoints], [etherscan])
#   - contracts/script/Deploy_sepolia.s.sol, Deploy_base.s.sol
#   - scripts/deploy.js, scripts/verify.js
#   - scripts/sepolia/*.js
#
# All scripts load contracts/.env via dotenv (from repo root).

# -----------------------------------------------------------------------------
# Wallet keys / addresses
# -----------------------------------------------------------------------------
# DEPLOYER_PK: broadcasts forge scripts; ReferralGraph.owner (and MockUSDC owner on Sepolia).
#   Cold after deploy. Not ContestFactory.operator.
# OPERATOR_PK: hot EOA. Address is set at deploy as:
#   - ContestFactory.operator (activate / lock / settle / cancel / push)
#   - ReferralGraph authorized oracle for REFERRAL_GROUP_ID (register / batchRegister)
#   Defaults to the deployer if unset (fine for solo testnet; split them for Base).
# REFERRAL_PLATFORM_ROOT_ADDRESS: required at deploy. Organic referral-tree parent
#   under REFERRAL_ROOT (not a contest constructor arg). Receives settlement referral
#   fees. Forge scripts revert if this is missing, zero, or equal to the operator.
#   deploy.js writes it to client/server chain JSON as referralPlatformRootAddress.
#   No private key here.
DEPLOYER_PK=your_deployer_private_key_without_0x_prefix
OPERATOR_PK=your_operator_private_key_without_0x_prefix
REFERRAL_PLATFORM_ROOT_ADDRESS=0xYourReferralPlatformRootAddressHere

# -----------------------------------------------------------------------------
# RPC URLs — foundry.toml; scripts/deploy.js; scripts/verify.js; JS scripts
# -----------------------------------------------------------------------------
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org

# -----------------------------------------------------------------------------
# Verification — foundry.toml [etherscan] (Basescan API key)
# -----------------------------------------------------------------------------
BASESCAN_API_KEY=your_basescan_api_key_here

# -----------------------------------------------------------------------------
# Referral contracts — Deploy_sepolia.s.sol, Deploy_base.s.sol; scripts/deploy.js;
# scripts/verify.js (ReferralGraph constructor args; RewardCalculator has none)
# -----------------------------------------------------------------------------
# ReferralGraph authorized oracle = OPERATOR_PK address (set above). No separate var needed.
# bytes32 group id (0x + 64 hex) — must match server REFERRAL_GROUP_ID
REFERRAL_GROUP_ID=

# -----------------------------------------------------------------------------
# JS scripts — address resolution
# -----------------------------------------------------------------------------
# If true, addresses are taken from latest deployment / server contract JSON.
# If false, set PAYMENT_TOKEN_ADDRESS below for manual mode.
USE_LATEST_DEPLOYMENT=true

# scripts/sepolia/mintPaymentToken.js (manual mode when USE_LATEST_DEPLOYMENT=false)
# scripts/sepolia/deployContestFactory.js (factory-only redeploy against existing stack)
PAYMENT_TOKEN_ADDRESS=
REFERRAL_GRAPH_ADDRESS=
REWARD_CALCULATOR_ADDRESS=

# scripts/sepolia/mintPaymentToken.js — recipient for minted mock USDC
RECIPIENT_ADDRESS=

# scripts/sepolia/mintPaymentToken.js — Mock USDC amount (6 decimals); default 10000000000
AMOUNT=10000000000

# =============================================================================
# Quick reference — which files read which variables
# =============================================================================
#
# foundry.toml
#   BASE_SEPOLIA_RPC_URL, BASE_RPC_URL, BASESCAN_API_KEY
#
# Deploy_sepolia.s.sol, Deploy_base.s.sol
#   DEPLOYER_PK, OPERATOR_PK, REFERRAL_GROUP_ID, REFERRAL_PLATFORM_ROOT_ADDRESS
# Deploy_sepolia_contest_factory.s.sol
#   + PAYMENT_TOKEN_ADDRESS, REFERRAL_GRAPH_ADDRESS, REWARD_CALCULATOR_ADDRESS
#
# scripts/deploy.js
#   DEPLOYER_PK, OPERATOR_PK, REFERRAL_PLATFORM_ROOT_ADDRESS, REFERRAL_GROUP_ID,
#   BASE_SEPOLIA_RPC_URL (sepolia) or BASE_RPC_URL (base)
#
# scripts/verify.js
#   DEPLOYER_PK, OPERATOR_PK, BASE_SEPOLIA_RPC_URL (sepolia) or BASE_RPC_URL (base)
#
# scripts/sepolia/mintPaymentToken.js
#   DEPLOYER_PK, BASE_SEPOLIA_RPC_URL, USE_LATEST_DEPLOYMENT, RECIPIENT_ADDRESS, AMOUNT,
#   PAYMENT_TOKEN_ADDRESS
#
# scripts/sepolia/pushPayouts.js
#   OPERATOR_PK, BASE_SEPOLIA_RPC_URL, CONTEST_CONTROLLER_ADDRESS
