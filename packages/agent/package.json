{
  "name": "@playthecut/agent",
  "version": "0.4.2",
  "description": "Agent toolkit for Play the Cut (playthecut.com)",
  "homepage": "https://playthecut.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MagRelo/cut.git",
    "directory": "packages/agent"
  },
  "keywords": [
    "playthecut",
    "agent"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "import": "./dist/contract.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "pnpm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "canonicalize": "^2.1.0",
    "viem": "^2.47.4",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
