generator client {
  provider = "prisma-client-js"
  seed     = "tsx prisma/seed.ts"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & social (sport-agnostic)
// ---------------------------------------------------------------------------

model User {
  id                        String    @id @default(cuid())
  privyUserId               String?   @unique
  email                     String?   @unique
  phone                     String?   @unique
  password                  String?
  name                      String
  userType                  String    @default("USER")
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  settings                  Json?
  isVerified                Boolean   @default(false)
  lastLoginAt               DateTime?
  loginAttempts             Int       @default(0)
  lockedUntil               DateTime?
  verificationCode          String?
  verificationCodeExpiresAt DateTime?

  referrerAddress       String?
  referralCode          String?   @unique
  referralGroupId       String?
  referredByUserId      String?
  referralChainId       Int?
  referralRecordedAt    DateTime?
  referralOnchainTxHash String?

  userGroups                   UserGroupMember[]
  lineups                      Lineup[]
  contestLineups               ContestLineup[]
  onchainPayments              OnchainPayment[]
  contestSecondaryParticipants ContestSecondaryParticipant[]
  wallets                      UserWallet[]
  emailSendLogs                EmailSendLog[]
  referredBy                   User?                         @relation("UserReferrals", fields: [referredByUserId], references: [id], onDelete: SetNull)
  referredUsers                User[]                        @relation("UserReferrals")

  @@index([email])
  @@index([phone])
  @@index([verificationCode])
  @@index([referredByUserId])
  @@index([referrerAddress])
  @@index([referredByUserId, referralChainId, referralGroupId])
}

model UserWallet {
  id        String   @id @default(cuid())
  userId    String
  chainId   Int
  publicKey String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([chainId, publicKey])
  @@index([userId])
  @@index([chainId])
  @@index([publicKey])
}

model UserGroup {
  id                    String   @id @default(cuid())
  name                  String
  description           String?
  inviteCode            String?  @unique
  inviteReferrerAddress String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  members  UserGroupMember[]
  contests Contest[]

  @@index([name])
}

model UserGroupMember {
  id          String   @id @default(cuid())
  userId      String
  userGroupId String
  role        String   @default("MEMBER")
  joinedAt    DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id])
  userGroup UserGroup @relation(fields: [userGroupId], references: [id])

  @@unique([userId, userGroupId])
}

// ---------------------------------------------------------------------------
// Sport registry & competition events
// ---------------------------------------------------------------------------

model Sport {
  id              String  @id
  name            String
  slug            String  @unique
  isEnabled       Boolean @default(true)
  rosterRules     Json
  scoringRules    Json
  predictionRules Json

  events       CompetitionEvent[]
  participants Participant[]
}

model CompetitionEvent {
  id         String   @id @default(cuid())
  sportId    String
  externalId String
  isActive   Boolean  @default(false)
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sport          Sport              @relation(fields: [sportId], references: [id])
  participants   EventParticipant[]
  lineups       Lineup[]
  contests      Contest[]
  emailSendLogs EmailSendLog[]

  @@unique([sportId, externalId])
  @@index([sportId, isActive])
  @@index([sportId, externalId])
}

model Participant {
  id          String   @id @default(cuid())
  sportId     String
  externalId  String?
  displayName String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sport             Sport              @relation(fields: [sportId], references: [id])
  eventParticipants EventParticipant[]

  @@unique([sportId, externalId])
  @@index([sportId])
}

model EventParticipant {
  id            String   @id @default(cuid())
  eventId       String
  participantId String
  scoreData     Json?
  total         Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  event       CompetitionEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participant Participant      @relation(fields: [participantId], references: [id], onDelete: Cascade)
  lineupPicks LineupPick[]

  @@unique([eventId, participantId])
  @@index([eventId])
  @@index([participantId])
}

// ---------------------------------------------------------------------------
// Lineups & contest entries
// ---------------------------------------------------------------------------

model Lineup {
  id         String   @id @default(cuid())
  userId     String
  eventId    String
  contestId  String?
  name       String
  prediction Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user           User             @relation(fields: [userId], references: [id])
  event          CompetitionEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  contest        Contest?         @relation(fields: [contestId], references: [id])
  picks          LineupPick[]
  contestLineups ContestLineup[]

  @@index([userId, eventId])
  @@index([userId, eventId, contestId])
}

model LineupPick {
  id                 String   @id @default(cuid())
  lineupId           String
  eventParticipantId String
  slotIndex          Int?
  createdAt          DateTime @default(now())

  lineup           Lineup           @relation(fields: [lineupId], references: [id], onDelete: Cascade)
  eventParticipant EventParticipant @relation(fields: [eventParticipantId], references: [id], onDelete: Cascade)

  @@unique([lineupId, eventParticipantId])
  @@index([lineupId])
}

model Contest {
  id                     String    @id @default(cuid())
  name                   String
  endTime                DateTime
  address                String?
  chainId                Int
  eventId                String
  status                 String
  userGroupId            String?
  description            String?
  settings               Json?
  results                Json?
  pickPopularity         Json?
  pickPopularityLockedAt DateTime?
  commentary                String?
  commentaryGeneratedAt     DateTime?
  commentaryFeed            Json?
  commentaryFeedGeneratedAt DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  event                 CompetitionEvent              @relation(fields: [eventId], references: [id])
  userGroup             UserGroup?                    @relation(fields: [userGroupId], references: [id])
  contestLineups        ContestLineup[]
  lineups               Lineup[]
  secondaryParticipants ContestSecondaryParticipant[]
  onchainPayments       OnchainPayment[]
  timelines             ContestLineupTimeline[]
  commentaryFeedJobs    CommentaryFeedJob[]

  @@index([eventId])
  @@index([userGroupId])
  @@index([status])
  @@index([chainId])
  @@index([chainId, eventId])
}

model CommentaryFeedJob {
  id         String    @id @default(cuid())
  contestId  String
  status     String // pending | running | done | failed
  payload    Json
  attempts   Int       @default(0)
  lastError  String?
  runAfter   DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)

  @@index([status, runAfter])
  @@index([contestId, status])
}

model ContestLineup {
  id              String   @id @default(cuid())
  contestId       String
  lineupId        String
  userId          String
  entryId         String?
  status          String
  score           Int?
  baseScore       Int?
  popularityBonus Int?
  position        Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  contest   Contest                 @relation(fields: [contestId], references: [id])
  lineup    Lineup                  @relation(fields: [lineupId], references: [id])
  user      User                    @relation(fields: [userId], references: [id])
  timelines ContestLineupTimeline[]

  @@unique([contestId, lineupId])
  @@unique([contestId, entryId])
  @@index([contestId])
  @@index([userId])
  @@index([status])
}

model ContestLineupTimeline {
  id              String   @id @default(cuid())
  contestLineupId String
  contestId       String
  timestamp       DateTime
  periodNumber    Int
  score           Int
  position        Int
  sharePrice      Float?
  createdAt       DateTime @default(now())

  contestLineup ContestLineup @relation(fields: [contestLineupId], references: [id], onDelete: Cascade)
  contest       Contest       @relation(fields: [contestId], references: [id])

  @@index([contestId, timestamp])
  @@index([contestLineupId, timestamp])
}

// ---------------------------------------------------------------------------
// On-chain payments & secondary market
// ---------------------------------------------------------------------------

enum PaymentKind {
  PRIMARY
  SECONDARY
  REFERRAL
}

model OnchainPayment {
  id              String      @id @default(cuid())
  kind            PaymentKind
  walletAddress   String
  userId          String?
  contestId       String?
  chainId         Int
  tokenAddress    String
  amountWei       String
  transactionHash String
  logIndex        Int?
  metadata        Json?
  notifiedAt      DateTime?
  createdAt       DateTime    @default(now())

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  contest Contest? @relation(fields: [contestId], references: [id], onDelete: SetNull)

  @@unique([transactionHash, logIndex, walletAddress])
  @@index([userId])
  @@index([contestId])
  @@index([transactionHash])
  @@index([kind])
  @@index([notifiedAt])
}

model ContestSecondaryParticipant {
  id                  String   @id @default(cuid())
  contestId           String
  entryId             String
  walletAddress       String
  userId              String?
  chainId             Int
  /// Cumulative payment-token wei deposited on this position (client-reported).
  amountWei           String?
  lastTransactionHash String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([contestId, entryId, walletAddress])
  @@index([contestId, entryId])
  @@index([walletAddress])
}

// ---------------------------------------------------------------------------
// Email program
// ---------------------------------------------------------------------------

model EmailSendLog {
  id             String   @id @default(cuid())
  kind           String
  dedupeKey      String   @unique
  recipientEmail String
  userId         String?
  eventId        String?
  campaignId     String?
  sentAt         DateTime @default(now())

  user  User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  event CompetitionEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([kind])
  @@index([userId])
  @@index([eventId])
  @@index([campaignId])
}
